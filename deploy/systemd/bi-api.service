[Unit]
After=network.target redis.service
Requires=network.target

[Service]
Type=simple
User=bi-platform
Group=bi-platform
WorkingDirectory=/opt/bi-platform/backend
EnvironmentFile=/opt/bi-platform/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/bi-platform/venv/bin/gunicorn config.wsgi:application -c /opt/bi-platform/deploy/gunicorn.conf.py
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
