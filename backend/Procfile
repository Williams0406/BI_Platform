web: gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --worker-class gthread --threads 2 --timeout 120 --access-logfile - --error-logfile -
worker: celery -A config.celery:app worker --loglevel=info -Q celery,fast,sql,imports,python,ml,optimization,maintenance
beat: celery -A config.celery:app beat --loglevel=info
